# The autoscaling daemon. Polls filesystem utilization and, when it crosses a
# device-count-dependent threshold, creates and folds in another EBS volume via
# create-ebs-volume. Amazon Linux 2023, systemd, lvm.ext4 only.

# 'local' is supported by dash and bash, the shells this runs under on AL2023.
# shellcheck disable=SC3043

EBS_AUTOSCALE_HOME="${EBS_AUTOSCALE_HOME:-/usr/local/ebs-autoscale}"
# shellcheck source=shared/utils.sh
. "${EBS_AUTOSCALE_HOME}/shared/utils.sh"

CREATE_VOLUME="${EBS_AUTOSCALE_HOME}/bin/create-ebs-volume"

# Tag written to every volume this tool attaches; its presence distinguishes an
# autoscaled volume from one attached for other reasons.
CREATION_TAG=amazon-ebs-autoscale-creation-time

# get_autoscaled_usage -> "NUM_DEVICES AUTOSCALED_GB", answered by one
# describe-volumes of the volumes this instance created. NUM_DEVICES counts
# those still attached to this instance that carry the creation tag.
# AUTOSCALED_GB sums the sizes of every volume this instance created, attached
# or not, independent of any local instance-store already in the volume group.
# Fails without output if EC2 cannot be queried: callers must not mistake that
# for an empty instance and create a volume while EC2 is throttling or down.
get_autoscaled_usage() {
    local response usage
    response=$(aws ec2 describe-volumes \
        --region "$AWS_REGION" \
        --filters "Name=tag:source-instance,Values=${INSTANCE_ID}" \
        --output json 2>/dev/null)
    [ -n "$response" ] || return 1
    usage=$(printf '%s' "$response" | jq -r --arg iid "$INSTANCE_ID" --arg tag "$CREATION_TAG" \
        '[([.Volumes[]
            | select(any(.Attachments[]?; .InstanceId == $iid))
            | select(any(.Tags[]?; .Key == $tag))] | length),
          ([.Volumes[].Size] | add // 0)] | "\(.[0]) \(.[1])"' 2>/dev/null)
    [ -n "$usage" ] || return 1
    printf '%s' "$usage"
}

# calc_threshold NUM_DEVICES -> utilization percent that triggers a new volume.
# The threshold rises as devices accumulate so late additions are less eager.
calc_threshold() {
    local num_devices="$1"
    if [ "$num_devices" -ge 4 ] && [ "$num_devices" -le 6 ]; then
        echo 80
    elif [ "$num_devices" -gt 6 ]; then
        echo 90
    else
        echo "$INITIAL_UTILIZATION_THRESHOLD"
    fi
}

# calc_new_size NUM_DEVICES -> size in GB for the next volume, clamped to the
# configured min/max. Larger volumes are used as the device count grows.
calc_new_size() {
    local num_devices="$1"
    local new_size="$MIN_EBS_VOLUME_SIZE"
    if [ "$num_devices" -ge 4 ] && [ "$num_devices" -le 6 ]; then
        if [ "$MAX_EBS_VOLUME_SIZE" -ge 299 ] && [ "$MIN_EBS_VOLUME_SIZE" -le 299 ]; then
            new_size=300
        elif [ "$MIN_EBS_VOLUME_SIZE" -ge 299 ]; then
            new_size="$MIN_EBS_VOLUME_SIZE"
        else
            new_size="$MAX_EBS_VOLUME_SIZE"
        fi
    elif [ "$num_devices" -gt 6 ] && [ "$num_devices" -le 10 ]; then
        if [ "$MAX_EBS_VOLUME_SIZE" -ge 999 ] && [ "$MIN_EBS_VOLUME_SIZE" -le 999 ]; then
            new_size=1000
        elif [ "$MIN_EBS_VOLUME_SIZE" -ge 999 ]; then
            new_size="$MIN_EBS_VOLUME_SIZE"
        else
            new_size="$MAX_EBS_VOLUME_SIZE"
        fi
    elif [ "$num_devices" -gt 10 ]; then
        new_size="$MAX_EBS_VOLUME_SIZE"
    fi
    echo "$new_size"
}

# read_fs_stats MOUNTPOINT -> "SIZE USED AVAIL PCT" (bytes, bytes, bytes, int %).
# Uses df --output so the columns are fixed and the long device-mapper name
# cannot wrap onto a second line and shift the fields, and -B1 so the percentage
# is not jittered by rounding sizes up to whole gigabytes.
read_fs_stats() {
    df -B1 --output=size,used,avail,pcent "$1" \
        | awk 'END { gsub(/%/, "", $4); print $1, $2, $3, $4 }'
}

# can_grow NUM_DEVICES AUTOSCALED_GB -> 0 if another volume may be added.
# Gates on the autoscaled bytes, not total filesystem size, so a large local
# instance-store already in the volume group does not disable autoscaling.
can_grow() {
    local num_devices="$1"
    local autoscaled_gb="$2"
    [ "$num_devices" -lt "$MAX_EBS_VOLUME_COUNT" ] || return 1
    [ "$autoscaled_gb" -lt "$MAX_LOGICAL_VOLUME_SIZE" ] || return 1
    return 0
}

# lvresize to use the whole volume group, tolerating exit 5 (already at size)
# and guarding against a hang on the LVM lock.
lvresize_full() {
    local lv="$1"
    local i=1
    local status
    while [ "$i" -le 3 ]; do
        timeout -k 6 60 lvresize -l 100%VG "$lv"
        status=$?
        if [ "$status" -eq 0 ] || [ "$status" -eq 5 ]; then
            return 0
        fi
        logerr "lvresize failed (status ${status}), attempt ${i}/3"
        sleep 2
        i=$(( i + 1 ))
    done
    return 1
}

# grow_filesystem DEVICE: fold a freshly attached device into the LV and grow ext4.
grow_filesystem() {
    local device="$1"
    local lv="/dev/mapper/${LVM_VG}-${LVM_LV}"
    case "$FILE_SYSTEM" in
        lvm.ext4)
            loginfo "adding ${device} to ${lv}"
            vgextend "$LVM_VG" "$device" || return 1
            lvresize_full "$lv" || return 1
            retry 3 resize2fs "$lv" || return 1
            ;;
        *)
            logerr "unsupported filesystem '${FILE_SYSTEM}'; only lvm.ext4 is supported"
            return 1
            ;;
    esac
}

# add_space NUM_DEVICES AUTOSCALED_GB: create one volume and extend the
# filesystem onto it.
# Returns 0 on success, 2 if a limit forbids growing, 1 if growing failed.
add_space() {
    local num_devices="$1"
    local autoscaled_gb="$2"
    if ! can_grow "$num_devices" "$autoscaled_gb"; then
        loginfo "not growing: devices=${num_devices}/${MAX_EBS_VOLUME_COUNT} autoscaled=${autoscaled_gb}/${MAX_LOGICAL_VOLUME_SIZE}GB"
        return 2
    fi
    local vol_size device
    vol_size=$(calc_new_size "$num_devices")
    loginfo "extending ${MOUNTPOINT} by ${vol_size}GB"
    device=$("$CREATE_VOLUME" --size "$vol_size" --max-attached-volumes "$MAX_EBS_VOLUME_COUNT")
    if [ -z "$device" ]; then
        logerr "failed to create or attach a volume"
        return 1
    fi
    if grow_filesystem "$device"; then
        loginfo "finished extending ${MOUNTPOINT}"
        return 0
    fi
    logerr "failed to extend the filesystem onto ${device}"
    return 1
}

# Daemon state: the attached autoscaled volume count and the utilization
# percent that triggers the next grow.
NUM_DEVICES=0
THRESHOLD=0

# After a failed grow the next attempt waits GROW_RETRY_DELAY seconds, doubling
# from GROW_RETRY_MIN_DELAY to GROW_RETRY_MAX_DELAY, so a persistent failure
# (permissions, capacity, a quota) does not hit the EC2 API on every tick. A
# limit that forbids growing waits GROW_RETRY_MAX_DELAY, as the limit may lift
# (a volume from a failed grow is still counted until EC2 finishes deleting it).
GROW_RETRY_MIN_DELAY=10
GROW_RETRY_MAX_DELAY=300
GROW_RETRY_DELAY=0
NEXT_GROW_ATTEMPT=0

# Seconds on a monotonic clock, unaffected by chrony stepping the wall clock at
# boot. Overridable so the backoff can be tested without waiting.
now_seconds() {
    local uptime
    read -r uptime _ < /proc/uptime
    printf '%s' "${uptime%.*}"
}

# attempt_grow PCT: called when utilization (PCT) is over the threshold.
# Updates the globals NUM_DEVICES and THRESHOLD after a successful grow.
# Returns 0 if EC2 was consulted and 1 if skipped (backing off).
attempt_grow() {
    local pct="$1"
    local now
    now=$(now_seconds)
    [ "$now" -ge "$NEXT_GROW_ATTEMPT" ] || return 1

    local usage autoscaled_gb
    local status=0
    if usage=$(get_autoscaled_usage); then
        NUM_DEVICES=${usage% *}
        autoscaled_gb=${usage#* }
        THRESHOLD=$(calc_threshold "$NUM_DEVICES")
        [ "$pct" -ge "$THRESHOLD" ] || return 0
        loginfo "low disk (${pct}%)"
        add_space "$NUM_DEVICES" "$autoscaled_gb" || status=$?
    else
        logerr "could not query EC2 for this instance's volumes"
        status=1
    fi
    now=$(now_seconds)
    case "$status" in
        0)
            NUM_DEVICES=$(( NUM_DEVICES + 1 ))
            THRESHOLD=$(calc_threshold "$NUM_DEVICES")
            GROW_RETRY_DELAY=0
            ;;
        2)
            GROW_RETRY_DELAY=0
            NEXT_GROW_ATTEMPT=$(( now + GROW_RETRY_MAX_DELAY ))
            loginfo "growth limit reached; checking again in ${GROW_RETRY_MAX_DELAY}s"
            ;;
        *)
            if [ "$GROW_RETRY_DELAY" -eq 0 ]; then
                GROW_RETRY_DELAY=$GROW_RETRY_MIN_DELAY
            else
                GROW_RETRY_DELAY=$(( GROW_RETRY_DELAY * 2 ))
                [ "$GROW_RETRY_DELAY" -le "$GROW_RETRY_MAX_DELAY" ] || GROW_RETRY_DELAY=$GROW_RETRY_MAX_DELAY
            fi
            NEXT_GROW_ATTEMPT=$(( now + GROW_RETRY_DELAY ))
            logerr "growing failed; next attempt in ${GROW_RETRY_DELAY}s"
            ;;
    esac
    return 0
}

run_daemon() {
    starting
    trap 'stopping; exit 0' INT TERM

    loginfo "mountpoint=${MOUNTPOINT} region=${AWS_REGION} az=${AWS_AZ}"

    until [ -d "$MOUNTPOINT" ]; do
        sleep 1
    done

    local log_count="$LOG_INTERVAL"
    local stats pct usage
    # Only the initial threshold depends on this; it is refreshed before any grow.
    usage=$(get_autoscaled_usage) || usage="0 0"
    NUM_DEVICES=${usage% *}
    THRESHOLD=$(calc_threshold "$NUM_DEVICES")

    while true; do
        stats=$(read_fs_stats "$MOUNTPOINT")
        pct=$(printf '%s' "$stats" | awk '{print $4}')

        if [ "${pct:-0}" -ge "$THRESHOLD" ]; then
            if attempt_grow "$pct"; then
                log_count="$LOG_INTERVAL"
            fi
        fi

        if [ "$log_count" -ge "$LOG_INTERVAL" ]; then
            loginfo "devices=${NUM_DEVICES} stats_bytes=[${stats}] util=${pct}% threshold=${THRESHOLD}%"
            log_count=0
        fi
        log_count=$(( log_count + 1 ))
        sleep "$DETECTION_INTERVAL"
    done
}

# Only run when executed directly; shellspec sources this file to unit-test the
# pure functions and sets SHELLSPEC_VERSION in that environment.
if [ -z "${SHELLSPEC_VERSION:-}" ]; then
    initialize

    MIN_EBS_VOLUME_SIZE=$(get_config_value .limits.min_ebs_volume_size)
    MAX_EBS_VOLUME_SIZE=$(get_config_value .limits.max_ebs_volume_size)
    MAX_LOGICAL_VOLUME_SIZE=$(get_config_value .limits.max_logical_volume_size)
    MAX_EBS_VOLUME_COUNT=$(get_config_value .limits.max_ebs_volume_count)
    INITIAL_UTILIZATION_THRESHOLD=$(get_config_value .limits.initial_utilization_threshold)
    FILE_SYSTEM=$(get_config_value .filesystem)
    LVM_VG=$(get_config_value .lvm.volume_group)
    LVM_LV=$(get_config_value .lvm.logical_volume)
    MOUNTPOINT=$(get_config_value .mountpoint)
    LOG_INTERVAL=$(get_config_value .logging.log_interval)
    DETECTION_INTERVAL=$(get_config_value .detection_interval)

    run_daemon
fi

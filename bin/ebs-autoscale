# The autoscaling daemon. Adds an EBS volume via create-ebs-volume when utilization
# crosses a device-count-dependent threshold or, in the exclusive free-space mode,
# when free space falls below min_free_space. Amazon Linux 2023, systemd, lvm.ext4 only.

# 'local' is supported by dash and bash, the shells this runs under on AL2023.
# shellcheck disable=SC3043

EBS_AUTOSCALE_HOME="${EBS_AUTOSCALE_HOME:-/usr/local/ebs-autoscale}"
# shellcheck source=shared/utils.sh
. "${EBS_AUTOSCALE_HOME}/shared/utils.sh"

CREATE_VOLUME="${EBS_AUTOSCALE_HOME}/bin/create-ebs-volume"

# get_autoscaled_usage -> "NUM_DEVICES AUTOSCALED_GB": attached autoscaled volumes and the
# GB of every volume this instance created. Fails without output if EC2 cannot be queried.
get_autoscaled_usage() {
    read_owned_volumes || return 1
    printf '%s %s' "$OWNED_ATTACHED_COUNT" "$OWNED_CREATED_GB"
}

# calc_threshold NUM_DEVICES -> utilization percent that triggers a new volume.
# The threshold rises as devices accumulate so late additions are less eager.
calc_threshold() {
    local num_devices="$1"
    if [ "$num_devices" -ge 4 ] && [ "$num_devices" -le 6 ]; then
        echo 80
    elif [ "$num_devices" -gt 6 ]; then
        echo 90
    else
        echo "$INITIAL_UTILIZATION_THRESHOLD"
    fi
}

# Bytes per GB as EBS counts them (GiB).
BYTES_PER_GB=1073741824

# space_is_low PCT AVAIL_BYTES -> 0 if free space is under MIN_FREE_SPACE GB when that is set, else if PCT is at THRESHOLD.
space_is_low() {
    local pct="$1"
    local avail_bytes="$2"
    if [ "$MIN_FREE_SPACE" -gt 0 ]; then
        [ -n "$avail_bytes" ] && [ $(( avail_bytes / BYTES_PER_GB )) -lt "$MIN_FREE_SPACE" ]
    else
        [ "${pct:-0}" -ge "$THRESHOLD" ]
    fi
}

# describe_trigger PCT AVAIL_BYTES -> the free GB and floor in free-space mode, else the utilization and threshold.
describe_trigger() {
    if [ "$MIN_FREE_SPACE" -gt 0 ]; then
        printf 'free=%sGB min_free=%sGB' "${2:+$(( $2 / BYTES_PER_GB ))}" "$MIN_FREE_SPACE"
    else
        printf 'util=%s%% threshold=%s%%' "$1" "$THRESHOLD"
    fi
}

# calc_new_size NUM_DEVICES AUTOSCALED_GB [SHORTFALL_GB] -> GB by device count, or the padded shortfall if larger, capped at the room left.
calc_new_size() {
    local num_devices="$1"
    local autoscaled_gb="$2"
    local shortfall_gb="${3:-0}"
    local room_gb=$(( MAX_LOGICAL_VOLUME_SIZE - autoscaled_gb ))
    local new_size="$MIN_EBS_VOLUME_SIZE"
    if [ "$num_devices" -ge 4 ] && [ "$num_devices" -le 6 ]; then
        if [ "$MAX_EBS_VOLUME_SIZE" -ge 299 ] && [ "$MIN_EBS_VOLUME_SIZE" -le 299 ]; then
            new_size=300
        elif [ "$MIN_EBS_VOLUME_SIZE" -ge 299 ]; then
            new_size="$MIN_EBS_VOLUME_SIZE"
        else
            new_size="$MAX_EBS_VOLUME_SIZE"
        fi
    elif [ "$num_devices" -gt 6 ] && [ "$num_devices" -le 10 ]; then
        if [ "$MAX_EBS_VOLUME_SIZE" -ge 999 ] && [ "$MIN_EBS_VOLUME_SIZE" -le 999 ]; then
            new_size=1000
        elif [ "$MIN_EBS_VOLUME_SIZE" -ge 999 ]; then
            new_size="$MIN_EBS_VOLUME_SIZE"
        else
            new_size="$MAX_EBS_VOLUME_SIZE"
        fi
    elif [ "$num_devices" -gt 10 ]; then
        new_size="$MAX_EBS_VOLUME_SIZE"
    fi
    if [ "$shortfall_gb" -gt 0 ]; then
        # Pad by 8%: ext4 keeps about 6.6% of each new volume (5% reserved blocks plus inode tables), which df's free space excludes.
        [ "$shortfall_gb" -ge "$MAX_EBS_VOLUME_SIZE" ] || shortfall_gb=$(( (shortfall_gb * 108 + 99) / 100 ))
        if [ "$shortfall_gb" -gt "$new_size" ]; then
            new_size="$shortfall_gb"
            [ "$new_size" -le "$MAX_EBS_VOLUME_SIZE" ] || new_size="$MAX_EBS_VOLUME_SIZE"
        fi
    fi
    [ "$room_gb" -lt "$new_size" ] && new_size="$room_gb"
    echo "$new_size"
}

# read_fs_stats MOUNTPOINT -> "SIZE USED AVAIL PCT" (bytes, bytes, bytes, int %).
# Uses df --output so the columns are fixed and the long device-mapper name
# cannot wrap onto a second line and shift the fields, and -B1 so the percentage
# is not jittered by rounding sizes up to whole gigabytes.
read_fs_stats() {
    df -B1 --output=size,used,avail,pcent "$1" \
        | awk 'END { gsub(/%/, "", $4); print $1, $2, $3, $4 }'
}

# can_grow NUM_DEVICES AUTOSCALED_GB -> 0 if another minimum-size volume may be added.
# Gates on the autoscaled bytes, not total filesystem size, so a large local
# instance-store already in the volume group does not disable autoscaling.
can_grow() {
    local num_devices="$1"
    local autoscaled_gb="$2"
    [ "$num_devices" -lt "$MAX_EBS_VOLUME_COUNT" ] || return 1
    [ "$autoscaled_gb" -lt "$MAX_LOGICAL_VOLUME_SIZE" ] || return 1
    [ $(( autoscaled_gb + MIN_EBS_VOLUME_SIZE )) -le "$MAX_LOGICAL_VOLUME_SIZE" ] || return 1
    return 0
}

# lvresize to use the whole volume group, guarding against a hang on the LVM lock.
# LVM also exits 5 for a missing LV or VG, so 5 means already at size only with no free extents.
lvresize_full() {
    local lv="$1"
    local i=1
    local status
    while [ "$i" -le 3 ]; do
        timeout -k 6 60 lvresize -l 100%VG "$lv"
        status=$?
        [ "$status" -eq 0 ] && return 0
        if [ "$status" -eq 5 ] && [ "$(vg_free_extents)" = 0 ]; then
            return 0
        fi
        logerr "lvresize failed (status ${status}), attempt ${i}/3"
        sleep 2
        i=$(( i + 1 ))
    done
    return 1
}

# grow_filesystem DEVICE: fold a freshly attached device into the LV and grow ext4.
grow_filesystem() {
    local device="$1"
    local lv="/dev/mapper/${LVM_VG}-${LVM_LV}"
    case "$FILE_SYSTEM" in
        lvm.ext4)
            loginfo "adding ${device} to ${lv}"
            vgextend "$LVM_VG" "$device" || return 1
            lvresize_full "$lv" || return 1
            retry 3 resize2fs "$lv" || return 1
            ;;
        *)
            logerr "unsupported filesystem '${FILE_SYSTEM}'; only lvm.ext4 is supported"
            return 1
            ;;
    esac
}

# lvm_report CMD [ARG...]: run an LVM report command under the lvresize timeout, logging failures.
lvm_report() {
    local status=0
    timeout -k 6 60 "$@" 2>>"$EBS_AUTOSCALE_LOG_FILE" || status=$?
    [ "$status" -eq 0 ] || logerr "$1 failed (status ${status})"
    return "$status"
}

# vg_free_extents -> the number of unallocated extents in the VG, empty if vgs fails.
vg_free_extents() {
    lvm_report vgs --noheadings -o vg_free_count "$LVM_VG" | tr -d ' '
}

# pv_table -> "DEVICE VG" for every PV, VG empty when in none; pvs reports EC2's /dev/sdX aliases.
pv_table() {
    local report pv vg
    report=$(lvm_report pvs --noheadings -o pv_name,vg_name) || return 1
    printf '%s\n' "$report" | while read -r pv vg; do
        if [ -n "$pv" ]; then
            printf '%s %s\n' "$(readlink -f "$pv")" "$vg"
        fi
    done
}

# disk_is_blank DEV -> 0 if DEV has no filesystem, partition table or partitions.
disk_is_blank() {
    lsblk -nro NAME,FSTYPE,PTTYPE "$1" 2>>"$EBS_AUTOSCALE_LOG_FILE" | awk 'END { exit !(NR == 1 && NF == 1) }'
}

# device_volume_id SERIALS DEV -> DEV's EBS volume ID from `lsblk -dno NAME,SERIAL` output,
# asking ebsnvme-id only when DEV has no serial; empty for any other device.
device_volume_id() {
    local serial ebsnvme
    serial=$(printf '%s\n' "$1" | awk -v name="${2#/dev/}" '$1 == name { print $2 }')
    case "$serial" in
        vol-*) printf '%s' "$serial" ;;
        vol?*) printf 'vol-%s' "${serial#vol}" ;;
        '')
            ebsnvme=${EBSNVME:-$(command -v ebsnvme-id 2>/dev/null || echo /usr/sbin/ebsnvme-id)}
            "$ebsnvme" -v "$2" 2>/dev/null | awk '/Volume ID:/ { print $3 }'
            ;;
    esac
}

# fold_stray_volumes VOLUME_IDS: grow onto those attached autoscaled volumes that are not in the VG,
# if blank or a PV in no VG. Returns 0 if it folded any, 1 if there were none, 2 on failure.
fold_stray_volumes() {
    local volume_ids="$1"
    local pvs_table serials dev pv_vg id vol
    local folded=1
    [ -n "$volume_ids" ] || return 1
    pvs_table=$(pv_table) || return 2
    if ! serials=$(lsblk -dno NAME,SERIAL 2>>"$EBS_AUTOSCALE_LOG_FILE"); then
        logerr "lsblk failed to list device serials"
        return 2
    fi
    for dev in $(_nvme_candidates); do
        # Empty when DEV is not a PV, "-" when it is a PV in no VG.
        pv_vg=$(printf '%s\n' "$pvs_table" | awk -v d="$dev" '$1 == d { print (NF > 1 ? $2 : "-") }')
        [ "$pv_vg" = "$LVM_VG" ] && continue
        id=$(device_volume_id "$serials" "$dev")
        for vol in $volume_ids; do
            [ -n "$id" ] && [ "$vol" = "$id" ] || continue
            if [ -n "$pv_vg" ] && [ "$pv_vg" != - ]; then
                logerr "not folding stray volume ${vol} (${dev}): it is in volume group ${pv_vg}"
                break
            elif [ -z "$pv_vg" ] && ! disk_is_blank "$dev"; then
                logerr "not folding stray volume ${vol} (${dev}): it has a filesystem or partitions"
                break
            fi
            loginfo "folding stray volume ${vol} (${dev}) into ${LVM_VG}"
            if ! grow_filesystem "$dev"; then
                logerr "failed to fold ${vol} (${dev}) into ${LVM_VG}"
                return 2
            fi
            folded=0
            break
        done
    done
    return "$folded"
}

# repair_delete_on_termination: enables DeleteOnTermination on each OWNED_MISSING_DOT volume, stopping at an authorization error.
repair_delete_on_termination() {
    local status
    # shellcheck disable=SC2086
    { set -f; set -- $OWNED_MISSING_DOT; set +f; }
    while [ "$#" -ge 2 ]; do
        status=0
        enable_delete_on_termination "$2" "$1" || status=$?
        [ "$status" -ne 2 ] || return 0
        shift 2
    done
}

# add_space NUM_DEVICES AUTOSCALED_GB [SHORTFALL_GB] -> 0 grown, 2 at a growth limit, 1 failed.
add_space() {
    local num_devices="$1"
    local autoscaled_gb="$2"
    local shortfall_gb="${3:-0}"
    if ! can_grow "$num_devices" "$autoscaled_gb"; then
        local limits="devices=${num_devices}/${MAX_EBS_VOLUME_COUNT} autoscaled=${autoscaled_gb}/${MAX_LOGICAL_VOLUME_SIZE}GB"
        [ $(( autoscaled_gb + MIN_EBS_VOLUME_SIZE )) -le "$MAX_LOGICAL_VOLUME_SIZE" ] || limits="${limits} min=${MIN_EBS_VOLUME_SIZE}GB"
        loginfo "not growing: ${limits}"
        return 2
    fi
    local vol_size device
    local status=0
    vol_size=$(calc_new_size "$num_devices" "$autoscaled_gb" "$shortfall_gb")
    loginfo "extending ${MOUNTPOINT} by ${vol_size}GB"
    device=$("$CREATE_VOLUME" --size "$vol_size" \
        --max-total-created-size "$MAX_LOGICAL_VOLUME_SIZE" \
        --max-attached-volumes "$MAX_EBS_VOLUME_COUNT") || status=$?
    case "$status" in
        0) ;;
        3) return 2 ;;
        *)
            logerr "failed to create or attach a volume (status ${status})"
            return 1
            ;;
    esac
    if [ -z "$device" ]; then
        logerr "failed to create or attach a volume"
        return 1
    fi
    if grow_filesystem "$device"; then
        loginfo "finished extending ${MOUNTPOINT}"
        return 0
    fi
    logerr "failed to extend the filesystem onto ${device}"
    return 1
}

# The attached volume count and the utilization percent that triggers a grow.
NUM_DEVICES=0
THRESHOLD=0
# Free-space floor in GB; 0 selects the utilization thresholds.
MIN_FREE_SPACE=0

# load_min_free_space: sets MIN_FREE_SPACE from the config or fails; a missing key reads as null and means off.
load_min_free_space() {
    MIN_FREE_SPACE=$(get_config_value .limits.min_free_space)
    case "$MIN_FREE_SPACE" in
        ''|null|0) MIN_FREE_SPACE=0; return 0 ;;
        *[!0-9]*|0*) ;;
        # 18 digits always fit in shell arithmetic.
        *) [ "${#MIN_FREE_SPACE}" -gt 18 ] || return 0 ;;
    esac
    logerr "invalid min_free_space '${MIN_FREE_SPACE}' in ${EBS_AUTOSCALE_CONFIG_FILE}: expected a positive whole number of GB with no leading zero"
    return 1
}

# Failed grows back off from 10 s, doubling to 5 min; a growth limit waits 5 min.
GROW_RETRY_MIN_DELAY=10
GROW_RETRY_MAX_DELAY=300
GROW_RETRY_DELAY=0
NEXT_GROW_ATTEMPT=0

# Set at startup and after a failed attempt, so strays are folded and DeleteOnTermination repaired even when space is not low.
RECONCILE_PENDING=1

# Whole seconds of uptime, a monotonic clock that chrony cannot step.
now_seconds() {
    local uptime
    read -r uptime _ < /proc/uptime
    printf '%s' "${uptime%.*}"
}

# attempt_grow PCT [AVAIL_BYTES]: repairs DeleteOnTermination, folds strays, refreshes NUM_DEVICES and THRESHOLD, grows if space_is_low; 1 if backing off.
attempt_grow() {
    local pct="$1"
    local avail_bytes="${2:-}"
    local now
    now=$(now_seconds)
    [ "$now" -ge "$NEXT_GROW_ATTEMPT" ] || return 1

    local status=0 fold=0 shortfall_gb=0
    if read_owned_volumes; then
        NUM_DEVICES=$OWNED_ATTACHED_COUNT
        THRESHOLD=$(calc_threshold "$NUM_DEVICES")
        repair_delete_on_termination
        fold_stray_volumes "$OWNED_ATTACHED_IDS" || fold=$?
        # A fold grew the filesystem, so PCT and AVAIL_BYTES are stale until the next tick.
        [ "$fold" -ne 0 ] || GROW_RETRY_DELAY=0
        if [ "$fold" -eq 2 ]; then
            status=1
        elif [ "$fold" -eq 0 ] || ! space_is_low "$pct" "$avail_bytes"; then
            RECONCILE_PENDING=0
            return 0
        else
            loginfo "low disk ($(describe_trigger "$pct" "$avail_bytes"))"
            [ "$MIN_FREE_SPACE" -eq 0 ] || shortfall_gb=$(( MIN_FREE_SPACE - avail_bytes / BYTES_PER_GB ))
            add_space "$NUM_DEVICES" "$OWNED_CREATED_GB" "$shortfall_gb" || status=$?
        fi
    else
        logerr "could not query EC2 for this instance's volumes"
        status=1
    fi
    now=$(now_seconds)
    RECONCILE_PENDING=0
    case "$status" in
        0)
            NUM_DEVICES=$(( NUM_DEVICES + 1 ))
            THRESHOLD=$(calc_threshold "$NUM_DEVICES")
            GROW_RETRY_DELAY=0
            ;;
        2)
            GROW_RETRY_DELAY=0
            NEXT_GROW_ATTEMPT=$(( now + GROW_RETRY_MAX_DELAY ))
            loginfo "growth limit reached; checking again in ${GROW_RETRY_MAX_DELAY}s"
            ;;
        *)
            RECONCILE_PENDING=1
            if [ "$GROW_RETRY_DELAY" -eq 0 ]; then
                GROW_RETRY_DELAY=$GROW_RETRY_MIN_DELAY
            else
                GROW_RETRY_DELAY=$(( GROW_RETRY_DELAY * 2 ))
                [ "$GROW_RETRY_DELAY" -le "$GROW_RETRY_MAX_DELAY" ] || GROW_RETRY_DELAY=$GROW_RETRY_MAX_DELAY
            fi
            NEXT_GROW_ATTEMPT=$(( now + GROW_RETRY_DELAY ))
            logerr "growing failed; next attempt in ${GROW_RETRY_DELAY}s"
            ;;
    esac
    return 0
}

run_daemon() {
    starting
    trap 'stopping; exit 0' INT TERM

    loginfo "mountpoint=${MOUNTPOINT} region=${AWS_REGION} az=${AWS_AZ}"

    until [ -d "$MOUNTPOINT" ]; do
        sleep 1
    done

    local log_count="$LOG_INTERVAL"
    local stats pct avail_bytes usage
    # Only the initial threshold depends on this; it is refreshed before any grow.
    usage=$(get_autoscaled_usage) || usage="0 0"
    NUM_DEVICES=${usage% *}
    THRESHOLD=$(calc_threshold "$NUM_DEVICES")

    while true; do
        stats=$(read_fs_stats "$MOUNTPOINT")
        # shellcheck disable=SC2086
        { set -f; set -- $stats; set +f; }
        avail_bytes=${3:-}; pct=${4:-}

        if space_is_low "$pct" "$avail_bytes" || [ "$RECONCILE_PENDING" -eq 1 ]; then
            if attempt_grow "${pct:-0}" "$avail_bytes"; then
                log_count="$LOG_INTERVAL"
            fi
        fi

        if [ "$log_count" -ge "$LOG_INTERVAL" ]; then
            loginfo "devices=${NUM_DEVICES} stats_bytes=[${stats}] $(describe_trigger "$pct" "$avail_bytes")"
            log_count=0
        fi
        log_count=$(( log_count + 1 ))
        sleep "$DETECTION_INTERVAL"
    done
}

# Only run when executed directly; shellspec sources this file to unit-test the
# pure functions and sets SHELLSPEC_VERSION in that environment.
if [ -z "${SHELLSPEC_VERSION:-}" ]; then
    initialize

    MIN_EBS_VOLUME_SIZE=$(get_config_value .limits.min_ebs_volume_size)
    MAX_EBS_VOLUME_SIZE=$(get_config_value .limits.max_ebs_volume_size)
    MAX_LOGICAL_VOLUME_SIZE=$(get_config_value .limits.max_logical_volume_size)
    MAX_EBS_VOLUME_COUNT=$(get_config_value .limits.max_ebs_volume_count)
    INITIAL_UTILIZATION_THRESHOLD=$(get_config_value .limits.initial_utilization_threshold)
    load_min_free_space || exit 1
    FILE_SYSTEM=$(get_config_value .filesystem)
    LVM_VG=$(get_config_value .lvm.volume_group)
    LVM_LV=$(get_config_value .lvm.logical_volume)
    MOUNTPOINT=$(get_config_value .mountpoint)
    LOG_INTERVAL=$(get_config_value .logging.log_interval)
    DETECTION_INTERVAL=$(get_config_value .detection_interval)

    run_daemon
fi

# Creates one EBS volume, attaches it to this instance, enables
# DeleteOnTermination, and prints the resulting block device path on stdout.
# Exits 3 when a limit forbids another volume and 1 on any other failure.
# Targets Amazon Linux 2023 on Nitro, where attached volumes appear as
# /dev/nvme*n1 rather than at the /dev/sd* name passed to attach-volume.

# 'local' is supported by dash and bash, the shells this runs under on AL2023.
# shellcheck disable=SC3043

EBS_AUTOSCALE_HOME="${EBS_AUTOSCALE_HOME:-/usr/local/ebs-autoscale}"
# shellcheck source=shared/utils.sh
. "${EBS_AUTOSCALE_HOME}/shared/utils.sh"

USAGE=$(cat <<USAGE_EOF
Create and attach an EBS volume, printing its device path.

    $0 [options] --size <volume_size_gb>

Required

    -s, --size          Size of the volume in GB.

Options

    -t, --type          Volume type. (Default: config.volume.type)
    -i, --iops          IOPS for io1, io2, gp3. (Default: config.volume.iops)
    --throughput        Throughput in MiB/s for gp3. (Default: config.volume.throughput)
    --not-encrypted     Create an unencrypted volume (default is encrypted).
    --max-total-created-size SIZE_GB
                        Max total GB of all volumes created by this instance.
                        (Default: config.limits.max_logical_volume_size)
    --max-attached-volumes N
                        Max number of attached volumes.
                        (Default: config.limits.max_ebs_volume_count)
    --max-created-volumes N
                        Max number of volumes created by this instance.
                        (Default: --max-attached-volumes)
USAGE_EOF
)

error() {
    logerr "$1"
    exit 1
}

limit_reached() {
    logerr "$1"
    exit 3
}

# get_next_logical_device CLAIMED
# Prints the first free BDM name in the AWS-recommended /dev/sd[f-z] data-volume
# namespace. A name is free when EC2 does not already report it attached to one
# of our volumes (the CLAIMED list, newline-separated) and no device node exists
# under either the sd or xvd suffix, which share a namespace. We allocate the BDM
# name from EC2's view rather than probing symlinks because the /dev/sd* udev
# symlink is unreliable on Nitro.
get_next_logical_device() {
    local claimed="$1"
    local letter cand
    for letter in f g h i j k l m n o p q r s t u v w x y z; do
        cand="/dev/sd${letter}"
        if printf '%s\n' "$claimed" | grep -qx "$cand"; then
            continue
        fi
        if [ -e "$cand" ] || [ -e "/dev/xvd${letter}" ]; then
            continue
        fi
        printf '%s' "$cand"
        return 0
    done
    return 1
}

# _nvme_candidates: print attached NVMe namespace devices, one per line.
# Factored out (and overridable) so the resolver can be unit-tested.
_nvme_candidates() {
    local dev
    for dev in /dev/nvme*n1; do
        [ -b "$dev" ] && printf '%s\n' "$dev"
    done
}

# match_nvme_device DEV VOLUME_ID SERIAL -> 0 if DEV is the block device for the
# volume. Matches the kernel-reported NVMe serial first (no external tool), then
# falls back to ebsnvme-id in both its legacy (-v) and subcommand (id -v) forms.
# The ebsnvme-id binary can be overridden with EBSNVME for testing.
match_nvme_device() {
    local dev="$1"
    local target_vol="$2"
    local target_serial="$3"
    local serial vid ebsnvme
    serial=$(lsblk -dno SERIAL "$dev" 2>/dev/null)
    if [ "$serial" = "$target_serial" ] || [ "$serial" = "$target_vol" ]; then
        return 0
    fi
    ebsnvme=${EBSNVME:-$(command -v ebsnvme-id 2>/dev/null || echo /usr/sbin/ebsnvme-id)}
    vid=$("$ebsnvme" -v "$dev" 2>>"$EBS_AUTOSCALE_LOG_FILE" \
        || "$ebsnvme" id -v "$dev" 2>>"$EBS_AUTOSCALE_LOG_FILE")
    vid=$(printf '%s' "$vid" | awk '/Volume ID:/{print $3}')
    [ "$vid" = "$target_vol" ]
}

# resolve_nvme_device VOLUME_ID
# Prints the real /dev/nvme*n1 path for an attached EBS volume, bounded so a
# volume that never appears is a logged error rather than an infinite hang.
# The timeout is overridable with EBS_AUTOSCALE_NVME_TIMEOUT (seconds).
resolve_nvme_device() {
    local target_vol="$1"
    local target_serial
    target_serial=$(printf '%s' "$target_vol" | tr -d -)
    local elapsed=0
    local timeout="${EBS_AUTOSCALE_NVME_TIMEOUT:-60}"
    local dev
    while [ "$elapsed" -lt "$timeout" ]; do
        for dev in $(_nvme_candidates); do
            if match_nvme_device "$dev" "$target_vol" "$target_serial"; then
                printf '%s' "$dev"
                return 0
            fi
        done
        sleep 1
        elapsed=$(( elapsed + 1 ))
    done
    logerr "resolve_nvme_device: timed out resolving ${target_vol}; lsblk: $(lsblk -o NAME,SERIAL 2>&1 | tr '\n' ' ')"
    return 1
}

# instance_tag_specifications INSTANCE_ID TIMESTAMP
# Prints a --tag-specifications JSON payload that copies this instance's
# non-aws: tags onto the new volume and adds our two bookkeeping tags. Built
# entirely with jq so tag values containing spaces, commas, or JSON
# metacharacters cannot corrupt the payload.
instance_tag_specifications() {
    local instance_id="$1"
    local timestamp="$2"
    local instance_tags
    instance_tags=$(
        aws ec2 describe-tags \
            --region "$AWS_REGION" \
            --filters "Name=resource-id,Values=${instance_id}" \
        | jq -rc '.Tags | map({Key, Value} | select(.Key | test("^aws:") | not))'
    )
    [ -n "$instance_tags" ] || instance_tags='[]'
    printf '%s' "$instance_tags" | jq -c \
        --arg iid "$instance_id" --arg ts "$timestamp" \
        '[{ResourceType:"volume", Tags: ([{Key:"source-instance",Value:$iid},{Key:"amazon-ebs-autoscale-creation-time",Value:$ts}] + .)}]'
}

# jittered_ms MILLIS
# Prints MILLIS scaled by a random factor in [0.75, 1.25]; dash lacks $RANDOM.
jittered_ms() {
    local millis="$1"
    local random
    random=$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ')
    printf '%s' $(( millis * (750 + ${random:-0} % 501) / 1000 ))
}

# wait_for_volume_available VOLUME_ID
# Polls with jittered backoff (1 s, x1.5, 5 s cap) until the volume is available.
# Fails on a describe error, on error/deleting/deleted, or after
# EBS_AUTOSCALE_VOLUME_AVAILABLE_TIMEOUT seconds of sleep (default 600).
wait_for_volume_available() {
    local volume_id="$1"
    local timeout_ms=$(( ${EBS_AUTOSCALE_VOLUME_AVAILABLE_TIMEOUT:-600} * 1000 ))
    local base_ms=1000
    local max_ms=5000
    local elapsed_ms=0
    local sleep_ms state
    while :; do
        if ! state=$(aws ec2 describe-volumes \
            --region "$AWS_REGION" \
            --volume-ids "$volume_id" \
            --query 'Volumes[0].State' \
            --output text 2>>"$EBS_AUTOSCALE_LOG_FILE"); then
            logerr "could not describe volume ${volume_id}"
            return 1
        fi
        case "$state" in
            available) return 0 ;;
            error|deleting|deleted)
                logerr "volume ${volume_id} entered state ${state}"
                return 1
                ;;
        esac
        [ "$elapsed_ms" -lt "$timeout_ms" ] || break
        sleep_ms=$(jittered_ms "$base_ms")
        sleep "$(printf '%d.%03d' $(( sleep_ms / 1000 )) $(( sleep_ms % 1000 )))"
        elapsed_ms=$(( elapsed_ms + sleep_ms ))
        base_ms=$(( base_ms * 3 / 2 ))
        [ "$base_ms" -le "$max_ms" ] || base_ms=$max_ms
    done
    logerr "timed out waiting for volume ${volume_id} to become available"
    return 1
}

create_and_attach_volume() {
    local instance_id="$INSTANCE_ID"
    local availability_zone="$AWS_AZ"
    local region="$AWS_REGION"

    # One describe-volumes for all accounting: this instance only ever attaches
    # volumes it created, so the source-instance set is a superset of what is
    # attached. The AWS CLI's adaptive retry (set in initialize) handles throttling.
    local owned
    owned=$(aws ec2 describe-volumes \
        --region "$region" \
        --filters "Name=tag:source-instance,Values=${instance_id}" \
        --output json 2>/dev/null)
    [ -n "$owned" ] || owned='{"Volumes":[]}'

    local created_count total_created_size attached_count claimed_devices
    created_count=$(printf '%s' "$owned" | jq '.Volumes | length')
    total_created_size=$(printf '%s' "$owned" | jq '[.Volumes[].Size] | add // 0')
    attached_count=$(printf '%s' "$owned" | jq --arg iid "$instance_id" \
        '[.Volumes[] | select(any(.Attachments[]?; .InstanceId == $iid))] | length')
    claimed_devices=$(printf '%s' "$owned" | jq -r --arg iid "$instance_id" \
        '.Volumes[].Attachments[]? | select(.InstanceId == $iid) | .Device')

    if [ "$total_created_size" -ge "$MAX_LOGICAL_VOLUME_SIZE" ]; then
        limit_reached "maximum total EBS volume size reached (${MAX_LOGICAL_VOLUME_SIZE} GB)"
    fi
    if [ "$created_count" -ge "$MAX_CREATED_VOLUMES" ]; then
        limit_reached "maximum number of created volumes reached (${MAX_CREATED_VOLUMES})"
    fi
    if [ "$attached_count" -ge "$MAX_ATTACHED_VOLUMES" ]; then
        limit_reached "maximum number of attached volumes reached (${MAX_ATTACHED_VOLUMES})"
    fi

    local bdm_device
    bdm_device=$(get_next_logical_device "$claimed_devices")
    if [ -z "$bdm_device" ]; then
        limit_reached "no device names available for a new volume"
    fi
    loginfo "next available device name: ${bdm_device}"

    local volume_opts="--size ${SIZE} --volume-type ${TYPE}"
    case "$TYPE" in
        io1|io2|gp3) volume_opts="${volume_opts} --iops ${IOPS}" ;;
    esac
    [ "$TYPE" = "gp3" ] && volume_opts="${volume_opts} --throughput ${THROUGHPUT}"
    [ "${ENCRYPTED:-0}" = "1" ] && volume_opts="${volume_opts} --encrypted"

    local timestamp
    timestamp=$(date -u "+%Y-%m-%dT%H:%M:%SZ")
    local tag_specifications
    tag_specifications=$(instance_tag_specifications "$instance_id" "$timestamp")

    local tmpfile
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/ebs-autoscale.create-volume.XXXXXXXXXX")

    # volume_opts is intentionally unquoted so its flags split into arguments.
    local volume volume_id
    # shellcheck disable=SC2086
    volume=$(aws ec2 create-volume \
        --region "$region" \
        --availability-zone "$availability_zone" \
        $volume_opts \
        --tag-specifications "$tag_specifications" \
        2>"$tmpfile")
    volume_id=$(printf '%s' "$volume" | jq -r '.VolumeId // empty')
    if [ -z "$volume_id" ]; then
        logerr "create-volume failed: $(tr '\n' ' ' < "$tmpfile")"
        rm -f "$tmpfile"
        error "could not create volume"
    fi
    rm -f "$tmpfile"
    loginfo "created volume ${volume_id} [${volume_opts}]"

    # If the volume never becomes available, delete it rather than leaking it
    # and then attaching something that is not ready.
    if ! wait_for_volume_available "$volume_id"; then
        local delete_err
        if ! delete_err=$(aws ec2 delete-volume --region "$region" --volume-id "$volume_id" 2>&1 >/dev/null); then
            error "volume ${volume_id} did not become available and could not be deleted, so it may leak: ${delete_err}"
        fi
        error "volume ${volume_id} did not become available; deleted it"
    fi

    loginfo "attaching volume ${volume_id} as ${bdm_device}"
    if ! aws ec2 attach-volume \
        --region "$region" \
        --device "$bdm_device" \
        --instance-id "$instance_id" \
        --volume-id "$volume_id" >/dev/null; then
        aws ec2 delete-volume --region "$region" --volume-id "$volume_id" >/dev/null 2>&1
        error "could not attach volume ${volume_id}; deleted it"
    fi

    # Resolve the real NVMe path for callers; the BDM name above is only what the
    # EC2 API understands, not necessarily a device that exists on the instance.
    local real_device
    real_device=$(resolve_nvme_device "$volume_id") || true
    if [ -z "$real_device" ]; then
        error "could not resolve the NVMe device for volume ${volume_id}"
    fi
    loginfo "volume ${volume_id} present as ${real_device} (bdm ${bdm_device})"

    # DeleteOnTermination must reference the BDM name, not the NVMe path. Retry
    # a few times; if it still fails the volume is usable but may outlive the
    # instance, so log loudly rather than aborting an otherwise-good attach.
    if retry 5 aws ec2 modify-instance-attribute \
        --region "$region" \
        --instance-id "$instance_id" \
        --block-device-mappings "DeviceName=${bdm_device},Ebs={DeleteOnTermination=true,VolumeId=${volume_id}}" >/dev/null; then
        loginfo "volume ${volume_id} DeleteOnTermination enabled"
    else
        logerr "volume ${volume_id} DeleteOnTermination NOT enabled after retries; it may outlive the instance"
    fi

    printf '%s\n' "$real_device"
}

# Only run when executed directly; shellspec sources this file to unit-test the
# individual functions and sets SHELLSPEC_VERSION in that environment.
if [ -z "${SHELLSPEC_VERSION:-}" ]; then
    [ -n "${EBS_AUTOSCALE_DEBUG:-}" ] && set -x

    TYPE=$(get_config_value .volume.type)
    IOPS=$(get_config_value .volume.iops)
    THROUGHPUT=$(get_config_value .volume.throughput)
    ENCRYPTED=$(get_config_value .volume.encrypted)
    MAX_LOGICAL_VOLUME_SIZE=$(get_config_value .limits.max_logical_volume_size)
    MAX_ATTACHED_VOLUMES=$(get_config_value .limits.max_ebs_volume_count)
    MAX_CREATED_VOLUMES=$MAX_ATTACHED_VOLUMES
    SIZE=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -s|--size)                  SIZE="$2"; shift 2 ;;
            -t|--type)                  TYPE="$2"; shift 2 ;;
            -i|--iops)                  IOPS="$2"; shift 2 ;;
            --throughput)               THROUGHPUT="$2"; shift 2 ;;
            --not-encrypted)            ENCRYPTED=0; shift ;;
            --max-total-created-size)   MAX_LOGICAL_VOLUME_SIZE="$2"; shift 2 ;;
            --max-attached-volumes)     MAX_ATTACHED_VOLUMES="$2"; shift 2 ;;
            --max-created-volumes)      MAX_CREATED_VOLUMES="$2"; shift 2 ;;
            -h|--help)                  echo "$USAGE"; exit 0 ;;
            -*)                         error "unsupported argument $1" ;;
            *)                          error "unexpected argument $1" ;;
        esac
    done

    if [ -z "$SIZE" ]; then
        echo "$USAGE" >&2
        error "missing required argument --size"
    fi

    initialize
    create_and_attach_volume
fi
